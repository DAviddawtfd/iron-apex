{
  "name": "iron-apex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "brand": "node scripts/make-brand.mjs && capacitor-assets generate --android --iconBackgroundColor #16161A --iconBackgroundColorDark #16161A --splashBackgroundColor #F2F2F4 --splashBackgroundColorDark #16161A && node -e \"require('fs').copyFileSync('assets/ic_stat_ironapex.xml','android/app/src/main/res/drawable/ic_stat_ironapex.xml')\"",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
